PORT=3000
DB_PATH=./data/database.sqlite

# Opcjonalne - jesli puste, klucze wygeneruja sie same przy pierwszym starcie
# i zapisza w bazie (musza zostac stabilne, wiec nie generuj ich ponownie
# recznie po tym, jak ktos juz zasubskrybuje powiadomienia).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:twoj@email.com

# Logging - console + daily files: readable app.*.log and full JSON in json/ (LOG_DIR=off disables the files)
# LOG_LEVEL: fatal | error | warn | info | debug
LOG_LEVEL=info
LOG_DIR=./data/logs
LOG_RETENTION_DAYS=14

# Reverse proxies whose X-Forwarded-For is trusted, so logs show the phone IP, not the proxy
# (Express "trust proxy": true / false / hop count / IPs). Default: this machine + local network
TRUST_PROXY=
